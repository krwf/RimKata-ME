<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RimKata_G</defName>
    <label>RimKata-G</label>
    <labelShortAdj>RimKata-G</labelShortAdj>
    <description>Predicts and responds to close-range gunfights. Enables the use of RimKata.</description>
    <iconPath>RimKata_main</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>250</displayOrderInCategory>
    <selectionWeight>0.05</selectionWeight>
    <biostatCpx>10</biostatCpx>
    <biostatMet>0</biostatMet>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly">
    <defName>ChemicalDependency_MindNumbSerum</defName>
    <label>mind-numb serum dependency</label>
    <labelShortAdj>mind-numb serum dependency</labelShortAdj>
    <description>Carriers depend psychologically on mind-numb serum. Without its effect, their mood deteriorates day by day unless an enduring romantic relationship or psychic bond lets them overcome the dependency.</description>
    <geneClass>KRWF.RimKata.Gene_MindNumbSerumDependency</geneClass>
    <iconPath>mind_gene</iconPath>
    <displayCategory>Drugs</displayCategory>
    <displayOrderInCategory>260</displayOrderInCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>4</biostatMet>
  </GeneDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly">
    <defName>MindNumbSerumEmotionRemoval</defName>
    <workerClass>KRWF.RimKata.ThoughtWorker_MindNumbSerumEmotionRemoval</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>emotion removal</label>
        <description>Equilibrium</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly">
    <defName>MindNumbSerumWithdrawal</defName>
    <thoughtClass>KRWF.RimKata.Thought_MindNumbSerumWithdrawal</thoughtClass>
    <workerClass>KRWF.RimKata.ThoughtWorker_MindNumbSerumWithdrawal</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <modExtensions>
      <li Class="KRWF.RimKata.RimKataMindNumbSerumWithdrawalExtension">
        <dailyMoodOffset>-5</dailyMoodOffset>
      </li>
    </modExtensions>
    <stages>
      <li>
        <label>mind-numb serum dependence</label>
        <description>My emotions are shaking me. I don't want any more catastrophes like insects, mechanoids, or anomalies.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly">
    <defName>MindNumbSerumDependencyOvercome</defName>
    <workerClass>KRWF.RimKata.ThoughtWorker_MindNumbSerumDependencyOvercome</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>mind-numb serum rejection</label>
        <description>If I am with my love</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
